            }
          },
          "required": [
            "mode",
            "path",
            "source_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "empty"
            },
            "path": {
              "$ref": "https://pbibrain.local/devcenter/contracts/defs.json#/$defs/full_path"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "mode",
            "name",
            "path"
          ],
          "additionalProperties": false
