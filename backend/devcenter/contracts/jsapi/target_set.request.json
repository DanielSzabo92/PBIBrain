            },
            "source_id": {
              "$ref": "https://pbibrain.local/devcenter/contracts/defs.json#/$defs/source_id"
            }
          },
          "required": [
            "mode",
            "source_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "copy_of"
            },
            "source_id": {
              "$ref": "https://pbibrain.local/devcenter/contracts/defs.json#/$defs/source_id"
            },
            "path": {
