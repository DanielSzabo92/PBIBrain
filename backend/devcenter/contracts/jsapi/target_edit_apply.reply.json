{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pbibrain.local/devcenter/contracts/jsapi/target_edit_apply.reply.json",
  "title": "JS API target_edit_apply: reply (an error reply uses error.json)",
  "type": "object",
  "properties": {
    "revision": {
      "$ref": "https://pbibrain.local/devcenter/contracts/defs.json#/$defs/revision"
    },
    "count": {
      "type": "integer",
      "minimum": 1
    },
    "row_keys": {
      "type": "array",
      "items": {
        "$ref": "https://pbibrain.local/devcenter/contracts/defs.json#/$defs/row_key"
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "row_key": {
            "$ref": "https://pbibrain.local/devcenter/contracts/defs.json#/$defs/row_key"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "row_key",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "revision",
    "count",
    "row_keys",
    "skipped"
  ],
  "additionalProperties": false
}
