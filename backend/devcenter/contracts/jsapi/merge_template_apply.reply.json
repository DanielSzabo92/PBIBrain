{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pbibrain.local/devcenter/contracts/jsapi/merge_template_apply.reply.json",
  "title": "JS API merge_template_apply: reply (an error reply uses error.json)",
  "type": "object",
  "properties": {
    "revision": {
      "$ref": "https://pbibrain.local/devcenter/contracts/defs.json#/$defs/revision"
    },
    "name": {
      "type": "string"
    },
    "applied": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "row_key": {
            "type": "string"
          },
          "reason": {
            "enum": [
              "bad_choice",
              "source_not_in_session"
            ]
          }
        },
        "required": [
          "row_key",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "applied",
    "name",
    "revision",
    "skipped"
  ],
  "additionalProperties": false
}
