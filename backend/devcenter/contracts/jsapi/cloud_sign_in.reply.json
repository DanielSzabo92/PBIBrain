{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pbibrain.local/devcenter/contracts/jsapi/cloud_sign_in.reply.json",
  "title": "JS API cloud_sign_in: reply (an error reply uses error.json). No file stores the account name.",
  "type": "object",
  "properties": {
    "revision": {
      "anyOf": [
        {
          "$ref": "https://pbibrain.local/devcenter/contracts/defs.json#/$defs/revision"
        },
        {
          "type": "null"
        }
      ]
    },
    "signed_in": {
      "type": "boolean"
    },
    "account_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "account_name",
    "reason",
    "revision",
    "signed_in"
  ],
  "additionalProperties": false
}
