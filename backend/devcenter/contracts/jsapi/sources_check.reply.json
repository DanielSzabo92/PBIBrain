{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pbibrain.local/devcenter/contracts/jsapi/sources_check.reply.json",
  "title": "JS API sources_check: reply (an error reply uses error.json)",
  "type": "object",
  "properties": {
    "revision": {
      "$ref": "https://pbibrain.local/devcenter/contracts/defs.json#/$defs/revision"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "$ref": "https://pbibrain.local/devcenter/contracts/defs.json#/$defs/source_id"
          },
          "status": {
            "$ref": "https://pbibrain.local/devcenter/contracts/defs.json#/$defs/source_status"
          }
        },
        "required": [
          "source_id",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "mark_count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "mark_count",
    "revision",
    "sources"
  ],
  "additionalProperties": false
}
