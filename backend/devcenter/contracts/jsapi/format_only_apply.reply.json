{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pbibrain.local/devcenter/contracts/jsapi/format_only_apply.reply.json",
  "title": "JS API format_only_apply: reply (an error reply uses error.json)",
  "type": "object",
  "properties": {
    "revision": {
      "$ref": "https://pbibrain.local/devcenter/contracts/defs.json#/$defs/revision"
    },
    "apply_id": {
      "type": "string",
      "pattern": "^apl-[0-9a-f]{16}$"
    },
    "kind": {
      "enum": [
        "apply",
        "format_only"
      ]
    },
    "file_count": {
      "type": "integer",
      "minimum": 0
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "desktop_state": {
      "enum": [
        "not_open",
        "open_saved",
        "open_unsaved",
        "not_reachable"
      ]
    },
    "notices": {
      "type": "array",
      "items": {
        "enum": [
          "apply_external_changes",
          "desktop_not_checked",
          "cloud_written"
        ]
      },
      "uniqueItems": true
    },
    "rescan_differences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "found": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "expected",
          "found",
          "object"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "apply_id",
    "desktop_state",
    "file_count",
    "files",
    "kind",
    "notices",
    "rescan_differences",
    "revision"
  ],
  "additionalProperties": false
}
