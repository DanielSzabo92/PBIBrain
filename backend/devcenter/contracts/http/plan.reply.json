{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pbibrain.local/devcenter/contracts/http/plan.reply.json",
  "title": "GET /api/devcenter/plan (section 14.1, UC2)",
  "type": "object",
  "properties": {
    "revision": {
      "$ref": "https://pbibrain.local/devcenter/contracts/defs.json#/$defs/revision"
    },
    "status": {
      "enum": [
        "valid",
        "valid_with_warnings",
        "invalid"
      ]
    },
    "summary": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "blocking": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "plan_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "blocking",
    "operations",
    "plan_hash",
    "revision",
    "status",
    "steps",
    "summary",
    "warnings"
  ],
  "additionalProperties": false
}
