{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pbibrain.local/devcenter/contracts/http/log.reply.json",
  "title": "GET /api/devcenter/log (section 14.1, UC8)",
  "type": "object",
  "properties": {
    "revision": {
      "$ref": "https://pbibrain.local/devcenter/contracts/defs.json#/$defs/revision"
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 1
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "has_more": {
      "type": "boolean"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "time": { "type": "string" },
          "author": { "type": "string" },
          "mcp_client": { "type": ["string", "null"] },
          "action": { "type": "string" },
          "target": {},
          "before": {},
          "after": {},
          "reason": { "type": ["string", "null"] },
          "proposal_id": { "type": ["string", "null"] },
          "revision": { "type": "integer" }
        },
        "required": ["time", "author", "action", "revision"],
        "additionalProperties": true
      }
    }
  },
  "required": ["entries", "has_more", "limit", "offset", "revision", "total"],
  "additionalProperties": false
}
