{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pbibrain.local/devcenter/contracts/http/apply-progress.reply.json",
  "title": "GET /api/devcenter/apply/progress (section 14.1, UC5)",
  "type": "object",
  "properties": {
    "revision": {
      "$ref": "https://pbibrain.local/devcenter/contracts/defs.json#/$defs/revision"
    },
    "apply_id": {
      "type": ["string", "null"]
    },
    "step": {
      "type": ["string", "null"]
    },
    "step_index": {
      "type": "integer",
      "minimum": 0
    },
    "step_count": {
      "type": "integer",
      "minimum": 0
    },
    "state": {
      "enum": ["running", "done", "failed"]
    }
  },
  "required": ["apply_id", "revision", "state", "step", "step_count", "step_index"],
  "additionalProperties": false
}
