{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pbibrain.local/devcenter/contracts/http/apply-preview.reply.json",
  "title": "GET apply/preview: reply (UC6)",
  "type": "object",
  "properties": {
    "revision": {
      "$ref": "https://pbibrain.local/devcenter/contracts/defs.json#/$defs/revision"
    },
    "ready": {
      "type": "boolean"
    },
    "plan_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": "object",
      "properties": {
        "add": {
          "type": "integer",
          "minimum": 0
        },
        "change": {
          "type": "integer",
          "minimum": 0
        },
        "remove": {
          "type": "integer",
          "minimum": 0
        },
        "rename": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "add",
        "change",
        "remove",
        "rename"
      ],
      "additionalProperties": false
    },
    "unconfirmed_marks": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "row_keys": {
          "type": "array",
          "items": {
            "$ref": "https://pbibrain.local/devcenter/contracts/defs.json#/$defs/row_key"
          }
        }
      },
      "required": [
        "count",
        "row_keys"
      ],
      "additionalProperties": false
    },
    "desktop_state": {
      "enum": [
        "not_open",
        "open_saved",
        "open_unsaved",
        "not_reachable"
      ]
    },
    "non_canonical_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "valid",
            "valid_with_warnings",
            "invalid",
            null
          ]
        },
        "failed_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "check": {
                "type": "string",
                "minLength": 1
              },
              "object": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "check",
              "message",
              "object"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "failed_checks",
        "status"
      ],
      "additionalProperties": false
    },
    "approvals_needed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "purpose": {
            "enum": [
              "HIGH_RISK_PROMOTION",
              "UNCHECKED_IMPACT"
            ]
          },
          "risk": {
            "enum": [
              "HIGH",
              "CRITICAL",
              null
            ]
          },
          "row_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "purpose",
          "risk",
          "row_keys"
        ],
        "additionalProperties": false
      }
    },
    "not_checked": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "object_id": {
            "type": "string",
            "minLength": 1
          },
          "object_name": {
            "type": "string"
          }
        },
        "required": [
          "object_id",
          "object_name"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "approvals_needed",
    "desktop_state",
    "non_canonical_files",
    "not_checked",
    "plan_hash",
    "ready",
    "revision",
    "summary",
    "unconfirmed_marks",
    "validation"
  ],
  "additionalProperties": false
}
