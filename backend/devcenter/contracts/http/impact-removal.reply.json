{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pbibrain.local/devcenter/contracts/http/impact-removal.reply.json",
  "title": "GET /api/devcenter/impact/removal/{object} (section 14.1, AC6)",
  "type": "object",
  "properties": {
    "revision": {
      "$ref": "https://pbibrain.local/devcenter/contracts/defs.json#/$defs/revision"
    },
    "object": {
      "type": "string"
    },
    "dependents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "object_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "domain": {
            "enum": [
              "model",
              "report"
            ]
          }
        },
        "required": [
          "name",
          "object_id",
          "type"
        ]
      }
    },
    "cascade": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "object_id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "effect": {
                "enum": [
                  "remove_object",
                  "remove_field_from_visual",
                  "remove_filter",
                  "remove_visual"
                ]
              }
            },
            "required": [
              "effect",
              "object_id"
            ]
          }
        }
      },
      "required": [
        "count",
        "effects"
      ],
      "additionalProperties": false
    },
    "repoint_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "object_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "data_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "type_warning": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "object_id",
          "type",
          "type_warning"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "cascade",
    "dependents",
    "object",
    "repoint_candidates",
    "revision"
  ],
  "additionalProperties": false
}
