{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pbibrain.local/devcenter/contracts/http/apply-last.reply.json",
  "title": "GET apply/last: reply (UC7)",
  "type": "object",
  "properties": {
    "revision": {
      "$ref": "https://pbibrain.local/devcenter/contracts/defs.json#/$defs/revision"
    },
    "apply_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^apl-[0-9a-f]{16}$"
    },
    "kind": {
      "enum": [
        "apply",
        "format_only",
        null
      ]
    },
    "finished_utc": {
      "anyOf": [
        {
          "$ref": "https://pbibrain.local/devcenter/contracts/defs.json#/$defs/utc_time"
        },
        {
          "type": "null"
        }
      ]
    },
    "file_count": {
      "type": "integer",
      "minimum": 0
    },
    "backup_present": {
      "type": "boolean"
    },
    "target_changed": {
      "type": "boolean"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rescan_differences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "found": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "expected",
          "found",
          "object"
        ],
        "additionalProperties": false
      }
    },
    "undone": {
      "type": "boolean"
    }
  },
  "required": [
    "apply_id",
    "backup_present",
    "changed_files",
    "file_count",
    "finished_utc",
    "kind",
    "rescan_differences",
    "revision",
    "target_changed"
  ],
  "additionalProperties": false
}
