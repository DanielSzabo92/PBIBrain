{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pbibrain.local/devcenter/contracts/http/apply-last.reply.json",
  "title": "GET /api/devcenter/apply/last (section 14.1, UC7)",
  "type": "object",
  "properties": {
    "revision": {
      "$ref": "https://pbibrain.local/devcenter/contracts/defs.json#/$defs/revision"
    },
    "apply_id": {
      "type": ["string", "null"]
    },
    "kind": {
      "enum": ["apply", "format_only", null]
    },
    "finished_utc": {
      "anyOf": [
        { "$ref": "https://pbibrain.local/devcenter/contracts/defs.json#/$defs/utc_time" },
        { "type": "null" }
      ]
    },
    "file_count": {
      "type": "integer",
      "minimum": 0
    },
    "backup_present": {
      "type": "boolean"
    },
    "target_changed": {
      "type": "boolean"
    },
    "changed_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "rescan_differences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "object": {},
          "expected": {},
          "found": {}
        },
        "required": ["expected", "found", "object"],
        "additionalProperties": true
      }
    },
    "desktop_warning": {
      "type": ["string", "null"]
    },
    "plan_hash": {
      "type": ["string", "null"]
    },
    "undone": {
      "type": "boolean"
    },
    "change_report_path": {
      "type": ["string", "null"]
    }
  },
  "required": [
    "apply_id",
    "backup_present",
    "changed_files",
    "file_count",
    "finished_utc",
    "kind",
    "rescan_differences",
    "revision",
    "target_changed"
  ],
  "additionalProperties": false
}
