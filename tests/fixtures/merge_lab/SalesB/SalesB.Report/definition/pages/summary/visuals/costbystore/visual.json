{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "costbystore",
  "position": {
    "x": 420,
    "y": 0,
    "z": 0,
    "width": 400,
    "height": 240,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Store"
                    }
                  },
                  "Property": "Store Label"
                }
              },
              "queryRef": "Store.Store Label",
              "nativeQueryRef": "Store Label",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Measures"
                    }
                  },
                  "Property": "Total Cost"
                }
              },
              "queryRef": "Measures.Total Cost",
              "nativeQueryRef": "Total Cost"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}
