table Store
	lineageTag: t-store

	column 'Store Key'
		dataType: int64
		lineageTag: c-store-key
		summarizeBy: none
		sourceColumn: StoreKey

	column 'Store Label'
		dataType: string
		sourceColumn: StoreName

	column Region
		dataType: string
		lineageTag: c-store-region
		sourceColumn: Region

	partition Store = m
		mode: import
		source =
				let
				    Source = #table({"StoreKey", "StoreName", "Region"}, {})
				in
				    Source

		annotation Columns = StoreKey, StoreName, Region

