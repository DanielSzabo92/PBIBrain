table 'Metric Selector'
	lineageTag: t-metric-selector

	column 'Metric Selector'
		dataType: string
		lineageTag: c-metric-selector
		summarizeBy: none
		sourceColumn: [Value1]
		sortByColumn: 'Metric Selector Order'

		relatedColumnDetails
			groupByColumn: 'Metric Selector Fields'

	column 'Metric Selector Fields'
		dataType: string
		isHidden
		lineageTag: c-metric-selector-fields
		summarizeBy: none
		sourceColumn: [Value2]

		extendedProperty ParameterMetadata =
				{
				  "version": 3,
				  "kind": 2
				}

	column 'Metric Selector Order'
		dataType: int64
		isHidden
		lineageTag: c-metric-selector-order
		summarizeBy: none
		sourceColumn: [Value3]

	partition 'Metric Selector' = calculated
		mode: import
		source =
				{
				    ("Total Sales", NAMEOF('Sales'[Total Sales]), 0),
				    ("Margin", NAMEOF('Sales'[Margin]), 1)
				}

