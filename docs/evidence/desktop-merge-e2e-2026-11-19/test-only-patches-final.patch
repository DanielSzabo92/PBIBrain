         return payload
+
+
+# TEST-ONLY PATCH (desktop merge E2E, 2026-11-19): the DevCenter plan uses the compare property
+# names (m_text, hidden, active, cross_filter_direction). ModelWriter.cs reads other names
+# (expression, partition_expression, is_hidden, is_active, cross_filtering_behavior). The table
+# create also adds a partition with the table name, so a partition create of the same name fails.
+def _test_only_writer_ops(operations: list) -> list:
+    import copy
+    ops = copy.deepcopy(operations)
+    created_tables = {op.get("name"): op for op in ops
+                      if op.get("op") == "CREATE" and op.get("object_type") == "table"}
+    out = []
+    for op in ops:
+        props = op.get("properties")
+        if isinstance(props, dict):
+            if "hidden" in props and "is_hidden" not in props:
+                props["is_hidden"] = props.pop("hidden")
+            if "active" in props and "is_active" not in props:
+                props["is_active"] = props.pop("active")
+            direction = props.get("cross_filter_direction")
+            if direction and "cross_filtering_behavior" not in props:
+                props["cross_filtering_behavior"] = direction
+            # Compare sorts the relationship ends by name and reverses the cardinality text to match.
+            # ModelWriter.cs takes ends[0] as the "from" (many) side, so put the many side first.
+            if op.get("object_type") == "relationship" and props.get("cardinality") == "one:many"                     and isinstance(props.get("ends"), list) and len(props["ends"]) == 2:
+                props["ends"] = [props["ends"][1], props["ends"][0]]
+                props["cardinality"] = "many:one"
+            if op.get("object_type") == "expression" and "m_text" in props and "expression" not in props:
+                props["expression"] = props["m_text"]
+        if op.get("op") == "CREATE" and op.get("object_type") == "partition":
+            table_op = created_tables.get(op.get("table"))
+            if table_op is not None and op.get("name") == op.get("table"):
+                tprops = table_op.setdefault("properties", {}) or {}
+                table_op["properties"] = tprops
+                if "expression" not in tprops and isinstance(props, dict) and props.get("m_text"):
+                    tprops["partition_expression"] = props["m_text"]
+                continue
+        out.append(op)
+    return out
