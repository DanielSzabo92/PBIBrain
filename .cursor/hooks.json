{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "matcher": "Read|Grep|Glob|Search|Shell",
        "command": "node .cursor/hooks/trail-hooks.cjs cursor-post-tool || exit 0"
      }
    ],
    "afterMCPExecution": [
      {
        "command": "node .cursor/hooks/trail-hooks.cjs cursor-mcp || exit 0"
      }
    ],
    "sessionEnd": [
      {
        "command": "node .cursor/hooks/trail-hooks.cjs cursor-session-end || exit 0"
      }
    ]
  }
}
